flowchart TD
    A[Entorno y necesidades sociales] --> B[Macroprocesos estrategicos]
    B --> C[Macroprocesos operativos]
    C --> D[Macroprocesos de soporte]
    D -. soporte transversal .-> C
    C --> E[Resultados institucionales]
    E --> F[Satisfaccion de grupos de interes y sociedad]
    F -. retroalimentacion .-> A

    B --> B1[Gestion de Gobierno Institucional]
    B --> B2[Gestion Integral de la Calidad]
    B --> B3[Gestion Estrategica y Economica]

    C --> C1[Gestion de Formacion Profesional]
    C --> C2[Gestion de Investigacion I+D+I+E]
    C --> C3[Gestion de Responsabilidad Social Universitaria]
    C --> C4[Gestion de Extension Universitaria]
    C --> C5[Gestion de Bienestar Social]

    D --> D1[Informacion - Comunicacion]
    D --> D2[Gestion Financiera]
    D --> D3[Gestion de Infraestructura y Laboratorios]
    D --> D4[Gestion de Talento Humano]
    D --> D5[Abastecimiento]

    classDef contexto fill:#eff6ff,stroke:#1d4ed8,color:#0f172a,stroke-width:2px
    classDef estrategico fill:#fef3c7,stroke:#b45309,color:#0f172a
    classDef operativo fill:#dcfce7,stroke:#15803d,color:#0f172a
    classDef soporte fill:#f3e8ff,stroke:#7e22ce,color:#0f172a
    classDef resultado fill:#fee2e2,stroke:#b91c1c,color:#0f172a,stroke-width:2px

    class A contexto
    class B,B1,B2,B3 estrategico
    class C,C1,C2,C3,C4,C5 operativo
    class D,D1,D2,D3,D4,D5 soporte
    class E,F resultado
